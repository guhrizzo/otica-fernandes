# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origem do painel admin, para a prévia ao vivo dentro do iframe (ex.: http://localhost:3000)
NEXT_PUBLIC_ADMIN_ORIGIN=
